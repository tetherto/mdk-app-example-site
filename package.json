{
  "name": "@tetherto/mdk-app-example-site",
  "version": "0.13.0",
  "description": "MDK MVP Site",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm run setup:config && npm install && npm run setup:satec && npm run build:ui",
    "setup:config": "node deploy/setup-config.js",
    "setup:satec": "node deploy/fetch-satec.js",
    "build:ui": "tsc -p ui && vite build ui",
    "dev:ui": "VITE_API_PORT=3000 vite ui",
    "preview:ui": "vite preview ui",
    "typecheck": "tsc -p ui",
    "start": "node start.js",
    "stop:pm2": "pm2 delete deploy/ecosystem.config.js",
    "lint": "standard",
    "test:unit": "NODE_ENV=test brittle tests/unit/git-deps.test.js tests/unit/pool-adapter.test.js tests/unit/ocean-adapter.test.js tests/unit/site-utils.test.js tests/unit/deploy-apps.test.js tests/unit/pools-controller.test.js tests/unit/start-roles.test.js tests/unit/site-lib.test.js tests/unit/site-tools-contract.test.js tests/unit/site-tools-results.test.js",
    "test:coverage": "NODE_ENV=test brittle --coverage tests/unit/git-deps.test.js tests/unit/pool-adapter.test.js tests/unit/ocean-adapter.test.js tests/unit/site-utils.test.js tests/unit/deploy-apps.test.js tests/unit/pools-controller.test.js tests/unit/start-roles.test.js tests/unit/site-lib.test.js tests/unit/site-tools-contract.test.js tests/unit/site-tools-results.test.js",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tetherto/mdk": "file:lib/mdk-compat",
    "@tetherto/mdk-app-agent": "git+https://github.com/tetherto/mdk-app-agent.git",
    "@tetherto/mdk-app-demo": "git+https://github.com/tetherto/mdk-app-demo.git",
    "@tetherto/mdk-app-operation-center": "git+https://github.com/tetherto/mdk-app-operation-center.git",
    "@tetherto/mdk-app-reporting-tool": "git+https://github.com/tetherto/mdk-app-reporting-tool.git",
    "@tetherto/mdk-app-runtime": "0.13.0",
    "@tetherto/mdk-client": "0.13.0",
    "@tetherto/mdk-core": "0.13.0",
    "@tetherto/mdk-gateway": "0.13.0",
    "@tetherto/mdk-identity": "0.13.0",
    "@tetherto/mdk-kernel": "0.13.0",
    "@tetherto/mdk-mcp": "0.13.0",
