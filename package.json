{
  "name": "@tetherto/mdk-app-example-site",
  "version": "0.0.1",
  "description": "MDK MVP Site",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm run setup:config && npm install && npm run build:ui",
    "setup:config": "node deploy/setup-config.js",
    "build:ui": "tsc -p ui && vite build ui",
    "dev:ui": "VITE_API_PORT=3000 vite ui",
    "preview:ui": "vite preview ui",
    "typecheck": "tsc -p ui",
    "start": "node start.js",
    "stop:pm2": "pm2 delete deploy/ecosystem.config.js",
    "lint": "standard",
    "test:unit": "NODE_ENV=test brittle tests/unit/git-deps.test.js tests/unit/pool-adapter.test.js tests/unit/pools-controller.test.js tests/unit/start-roles.test.js tests/unit/site-tools-contract.test.js tests/unit/site-tools-results.test.js",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tetherto/mdk": "file:lib/mdk-compat",
    "@tetherto/mdk-app-runtime": "^0.12.1",
    "@tetherto/mdk-client": "^0.12.1",
    "@tetherto/mdk-core": "^0.12.1",
    "@tetherto/mdk-mcp": "^0.12.1",
    "@tetherto/mdk-worker": "^0.12.1",
    "@tetherto/mdk-kernel": "^0.12.1",
    "@tetherto/mdk-gateway": "^0.12.1",
    "@tetherto/mdk-react-adapter": "^0.12.1",
    "@tetherto/mdk-react-devkit": "^0.12.1",
    "@tetherto/mdk-ui-foundation": "^0.12.1",
    "antminer-mdk-worker": "git+https://github.com/bitmain-official/antminer-mdk-worker.git#4fd776b4a048a1bc8284ec2eceed82b4631f960c",
    "emcd-mdk-worker": "git+https://github.com/emcdio/emcd-mdk-worker.git#3ad188e1fef8fa080ce5096d7421e9b3a7052515",
    "foundry-mdk-worker": "git+https://github.com/foundryservices/foundry-mdk-worker.git#310172ebe1cb4ef60cd14f39d9467f2c8e2bc534",
    "mdk-crypto-lib": "file:lib/mdk-crypto-lib",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.3.0",
    "sealminer-mdk-worker": "git+https://github.com/sealminer/sealminer-mdk-worker.git#63211a12245482cffb2d09f8cbeaa4c6411e51a3",
    "spiderpool-mdk-worker": "git+https://github.com/SpiderPool-New/spiderpool-mdk-worker.git#345f4a2b46ff59135eb4dad1803f0653c3d88911",
    "whatsminer-mdk-worker": "git+https://github.com/whatsminer/whatsminer-mdk-worker.git#a47fa82020454f9bfa9963ccaaa319b7948e8aa2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "crypto-js": "file:lib/mdk-crypto-lib",
    "nanoid@<3.3.18": ">=3.3.18 <4.0.0",
    "source-map-js": "1.2.2",
    "@fastify/static": "10.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "brittle": "3.18.0",
    "standard": "17.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  }
}
